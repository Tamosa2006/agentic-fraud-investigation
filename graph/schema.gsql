CREATE VERTEX Customer (PRIMARY_ID customer_id STRING)
CREATE VERTEX Card (PRIMARY_ID card_id STRING)
CREATE VERTEX Transaction (PRIMARY_ID txn_id STRING, amount DOUBLE, ts DATETIME,
                           channel STRING, product_cd STRING, region STRING,
                           email_domain STRING, card_type STRING, risk_score DOUBLE)
CREATE VERTEX Device (PRIMARY_ID device_id STRING)
CREATE VERTEX FraudCase (PRIMARY_ID case_id STRING, outcome STRING, pattern STRING,
                         opened_at DATETIME, closed_at DATETIME,
                         exposure_usd DOUBLE, analyst_notes STRING)

CREATE DIRECTED EDGE owns_card (FROM Customer, TO Card) WITH REVERSE_EDGE="owned_by"
CREATE DIRECTED EDGE made_txn (FROM Customer, TO Transaction) WITH REVERSE_EDGE="made_by"
CREATE DIRECTED EDGE used_device (FROM Transaction, TO Device) WITH REVERSE_EDGE="device_of"
CREATE DIRECTED EDGE case_txn (FROM FraudCase, TO Transaction) WITH REVERSE_EDGE="txn_in_case"
CREATE DIRECTED EDGE case_card (FROM FraudCase, TO Card) WITH REVERSE_EDGE="card_in_case"
CREATE DIRECTED EDGE case_customer (FROM FraudCase, TO Customer) WITH REVERSE_EDGE="customer_in_case"
CREATE DIRECTED EDGE ring_link (FROM FraudCase, TO Card) WITH REVERSE_EDGE="ring_of"